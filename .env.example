# Copy to `.env` for local development. Docker Compose and CI inject real
# values directly as environment variables instead of reading this file.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DATABASE_URL=postgres://app:app@localhost:5432/ledgerflow
DB_CONN_MAX_AGE=60

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# --- Field encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
FIELD_ENCRYPTION_KEY=

# --- MFA ---
MFA_ISSUER_NAME=LedgerFlow
MFA_CHALLENGE_TTL_SECONDS=300
MFA_BACKUP_CODE_COUNT=10
MFA_TOTP_VALID_WINDOW=1

# --- WebAuthn / Passkeys ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LedgerFlow
WEBAUTHN_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# --- OAuth ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_STATE_TTL_SECONDS=600

# --- Invitations ---
INVITATION_TTL_DAYS=7

# --- Throttling ---
THROTTLE_AUTH=10/min
THROTTLE_MFA_VERIFY=5/min
THROTTLE_WRITE=120/min
THROTTLE_READ=1000/min

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Object storage (production) ---
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMATTER=console

# --- Downtime alerting (deploy/install-monitor.sh) ---
# Only used on a server. The monitor probes /readyz/ every minute and alerts
# after ALERT_AFTER_FAILURES consecutive failures, with deploy/doctor.sh output
# attached. Set at least one channel or install-monitor.sh refuses to install —
# a monitor with nobody to tell looks like coverage and is not.
#
# Webhook is the more reliable of the two: it has no dependency on mail
# deliverability, which matters because the thing that is down may be the thing
# that would have sent the mail. Slack, Discord and ntfy URLs all work.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_URL=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_AFTER_FAILURES=3

# The dead-man's switch, and the only thing that survives the host dying.
# The monitor pings this after every *successful* probe; the service on the
# other end alerts when the pings stop. Silence becomes the signal, instead of
# relying on a dying machine to send its own obituary.
# Works with Healthchecks.io, Better Stack, Cronitor, or an UptimeRobot
# heartbeat monitor — one URL, no account plumbing in this repo.
MONITOR_HEARTBEAT_URL=

# --- Container network (deploy/docker-compose.server.yml) ---
# Override only if 172.28.0.0/16 collides with something this host routes.
# Anything inside 172.16.0.0/12 stays covered by deploy/firewall-docker.sh.
DOCKER_SUBNET=172.28.0.0/16
