# Caddy: single origin for the whole product.
#   /api/*, /django-admin/*, /healthz, /static/*  -> Django (gunicorn)
#   everything else (incl. the SPA's /admin console) -> React static files
#
# Automatic HTTPS via Let's Encrypt. {$DOMAIN}/{$ACME_EMAIL} come from .env.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# --- Backend: API, admin, health, and Django's own static (admin/DRF UI) ---
	@backend path /api/* /django-admin/* /healthz /healthz/ /readyz /readyz/ /static/*
	handle @backend {
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			header_up Host {host}
		}
	}

	# --- Frontend: the built SPA. try_files makes client-side routes (/goals,
	# /transactions, …) resolve to index.html so a hard refresh doesn't 404. ---
	handle {
		root * /srv/frontend

		# Cache policy is the deploy-latency policy — see Caddyfile.internal
		# for the incident behind it. Hashed assets are immutable and get the
		# year; index.html and sw.js must revalidate on every navigation, or a
		# deploy stays invisible (stale service worker pinning the old shell)
		# and can white-screen (stale index requesting assets the new build
		# replaced, with try_files feeding HTML to a <script type=module>).
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
